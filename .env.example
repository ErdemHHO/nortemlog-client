# Public site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://nortemlog.com

# Social profiles shown in the header, footer and structured data.
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/nortemlog
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/nortemlog

# --- Form delivery (quote + contact) ---------------------------------------
# Mail is sent via SMTP. For Gmail: turn on 2-step verification on the sending
# account, create an "App password" (Google Account > Security > App passwords)
# and use it as SMTP_PASS. Never use the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER (Gmail only allows sending as the account itself).
SMTP_FROM=
# Required: the inbox that receives quote requests.
INQUIRY_TO_EMAIL=

# Optional extra channel: also POST every submission as JSON (Slack/Zapier/CRM).
INQUIRY_WEBHOOK_URL=
